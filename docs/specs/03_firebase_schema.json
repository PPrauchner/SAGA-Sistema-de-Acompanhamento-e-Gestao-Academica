  "mapeamento_paginas_firestore": {
    "LoginPage": {
      "colecoes_lidas": [],
      "operacoes": ["Firebase Auth signInWithEmailAndPassword", "GET /api/v1/auth/me → users/{uid}"]
    },
    "FirstAccessPage": {
      "colecoes_lidas": ["invites/{token}"],
      "operacoes": ["Valida token em invites/", "Firebase Auth createUserWithEmailAndPassword", "POST /api/v1/auth/first-access → cria users/{uid} e seta custom claims"]
    },
    "AlunoDashboard": {
      "colecoes_lidas": ["students/{id}", "students/{id}/activities", "students/{id}/work_plan", "notifications"],
      "operacoes": ["GET /api/v1/dashboard/aluno/{id}", "onSnapshot notifications"]
    },
    "OrientadorDashboard": {
      "colecoes_lidas": ["students (filtrado por orientador_id)", "students/*/activities", "notifications"],
      "operacoes": ["GET /api/v1/dashboard/orientador/{id}"]
    },
    "CoordDashboard": {
      "colecoes_lidas": ["students", "audit_logs (recentes)", "notifications"],
      "operacoes": ["GET /api/v1/dashboard/coordenacao"]
    },
    "StudentsPage": {
      "colecoes_lidas": ["students", "advisors"],
