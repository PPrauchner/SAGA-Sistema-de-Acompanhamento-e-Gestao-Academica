      },
      "usado_pelo_motor": "Fatos: proficiencia_comprovada(id), qualificacao_aprovada(id), prazo_estourado(id) calculado a partir de prazo_final",
      "sub_colecoes": {
        "work_plan": {
          "descricao": "Plano de trabalho do aluno (tipicamente 1 por aluno no MVP)",
          "documento_id": "auto-id",
          "campos": {
            "titulo": "string",
            "data_inicio": "Timestamp",
