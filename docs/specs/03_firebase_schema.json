                    "atualizado_em": "Timestamp"
                  },
                  "usado_pelo_motor": "Fato task_concluida(task_id, aluno_id) quando status='concluida'",
                  "sub_colecoes": {
                    "updates": {
                      "descricao": "Atualizações de progresso registradas pelo aluno",
                      "campos": {
                        "conteudo": "string",
                        "percentual": "float (0-100)",
                        "autor_id": "string (uid aluno)",
                        "criado_em": "Timestamp"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "activities": {
          "descricao": "Atividades creditáveis registradas pelo aluno",
          "documento_id": "auto-id",
          "campos": {
            "tipo_id": "string (referência a activity_types/) | null (null em atividades bibliográficas)",
