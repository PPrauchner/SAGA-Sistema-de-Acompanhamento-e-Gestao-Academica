            "status_geral": "string ('em_andamento'|'atrasado'|'concluido')",
            "criado_por": "string (uid orientador)",
            "criado_em": "Timestamp",
            "atualizado_em": "Timestamp"
          },
          "sub_colecoes": {
            "stages": {
              "descricao": "Etapas do plano",
