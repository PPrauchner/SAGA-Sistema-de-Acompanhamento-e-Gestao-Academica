{
  "modulo": "Schema Firebase — Firestore + Authentication",
  "versao": "1.0.0-MVP",
  "descricao": "Schema completo do Firestore com todas as coleções, campos e relacionamentos. Inclui mapeamento das 17 páginas React para suas coleções, seed de fatos de configuração do motor lógico e regras de segurança.",
  "tenant": "single-tenant com programa_id presente nas entidades relevantes",

  "requisitos_fundo": [
    "Firebase Admin SDK inicializado no lifespan do FastAPI via backend/app/core/firebase.py",
    "Firebase Auth com custom claims: { role: 'aluno'|'orientador'|'coordenacao', programa_id: 'prog_default' }",
    "Firestore como único banco de dados — nenhuma outra persistência no MVP",
    "Regras de segurança do Firestore: escrita apenas via backend (Admin SDK) — frontend lê apenas as próprias notificações via onSnapshot",
    "Comprovante de atividade/produção: upload real via Firebase Storage faz parte do MVP — o arquivo é enviado ao bucket e o campo comprovante_url recebe a URL de download gerada"
  ],

  "firebase_storage": {
    "descricao": "Upload real de comprovantes de atividades e produções. Faz parte do MVP (desvio consciente vs. specs originais, que tratavam o comprovante como URL string e o Storage como opcional).",
    "bucket": "{FIREBASE_PROJECT_ID}.appspot.com",
    "estrutura_paths": "comprovantes/{programa_id}/{student_id}/{activity_id}/{filename}",
    "campo_url_gerado": "comprovante_url em students/{id}/activities recebe a URL de download retornada pelo upload",
    "regras_acesso": [
      "Upload exclusivamente via backend (Admin SDK) — o frontend nunca escreve direto no bucket",
      "Leitura via URL de download tokenizada, restrita ao próprio aluno, ao seu orientador e à coordenação",
      "Tipos permitidos: PDF e imagens (JPEG/PNG); tamanho máximo validado no backend"
    ]
  },

  "colecoes": {
    "programs": {
      "descricao": "Configuração do programa de pós-graduação. Contém os fatos de configuração do motor lógico.",
      "documento_id": "prog_default (single-tenant)",
      "campos": {
        "nome": "string",
        "instituicao": "string",
        "duracao_meses": "int (default: 24)",
        "creditos_grupo_basico_min": "int (default: 12)",
        "creditos_grupo_especifico_min": "int (default: 8)",
        "creditos_grupo_tecnologico_max": "int (default: 4)",
        "creditos_total_min": "int (default: 24)",
        "max_prorrogacoes": "int (default: 1)",
        "duracao_prorrogacao_meses": "int (default: 6)",
        "meses_ate_qualificacao": "int (default: 12)",
        "criado_em": "Timestamp",
        "atualizado_em": "Timestamp"
      },
      "sub_colecoes": {
        "vehicle_levels": {
          "descricao": "Nível de relevância de veículos configurável por programa. Fato do motor.",
          "documento_id": "veiculo_id",
          "campos": {
            "veiculo_id": "string",
            "nivel": "string ('A1'|'A2'|'A3'|'A4'|'A5'|'A6'|'A7'|'A8'|'SC') — Qualis Único; SC = Sem Classificação",
            "peso": "float (A1=1.0, A2=0.9, A3=0.8, A4=0.7, A5=0.6, A6=0.5, A7=0.4, A8=0.3, SC=0.0) — escala monotônica",
            "atualizado_em": "Timestamp",
            "atualizado_por": "string (uid)"
          }
        }
      },
      "usado_pelo_motor": "Fatos: min_creditos_basico, min_creditos_especifico, max_creditos_tecnologico, min_creditos_total, max_prorrogacoes, relevancia_peso"
    },

    "users": {
      "descricao": "Dados de perfil de todos os usuários. Sincronizado com Firebase Auth custom claims.",
      "documento_id": "uid (Firebase Auth)",
      "campos": {
        "uid": "string",
        "email": "string",
        "nome": "string",
        "role": "string ('aluno'|'orientador'|'coordenacao')",
        "programa_id": "string",
        "ativo": "boolean",
        "primeiro_acesso_completo": "boolean",
        "criado_em": "Timestamp",
        "atualizado_em": "Timestamp"
      }
    },

    "students": {
      "descricao": "Discentes do programa. Entidade central do sistema.",
      "documento_id": "auto-id Firestore",
      "campos": {
        "uid": "string (referência a users/)",
