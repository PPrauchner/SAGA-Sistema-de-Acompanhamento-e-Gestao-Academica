# ============================================================
# Backend — Firebase Admin SDK
# ============================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ============================================================
# API
# ============================================================
API_VERSION=1.0.0-MVP
# Origens permitidas no CORS — array JSON (NÃO vírgula-separado). Para múltiplas origens
# (ex: acesso por outro dispositivo via `pnpm dev --host`), liste o IP da rede também:
# CORS_ORIGINS=["http://localhost:5173","http://192.168.0.10:5173"]
CORS_ORIGINS=["http://localhost:5173"]

# Base do frontend — usada para montar o link de primeiro acesso enviado por e-mail.
FRONTEND_URL=http://localhost:5173

# ============================================================
# E-mail (convite de primeiro acesso)
# ============================================================
# Provedor de envio. "smtp" é o único suportado hoje; trocar de provedor é só
# trocar estas variáveis (qualquer servidor SMTP: Gmail, Mailtrap, Brevo, etc.).
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente exibido no e-mail; se vazio, usa SMTP_USER.
SMTP_FROM=no-reply@saga.local
SMTP_USE_TLS=true
# Mantém o token na resposta de POST /auth/invite (fallback de dev/testes).
# Em produção, definir como false para que o token saia apenas por e-mail.
EXPOSE_INVITE_TOKEN=true

# ============================================================
# Frontend — Vite (variáveis expostas ao browser, prefixo VITE_)
# ============================================================
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIRESTORE_DB=(default)
