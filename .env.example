# ============================================================
# Backend — Firebase Admin SDK
# ============================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ============================================================
# API
# ============================================================
API_VERSION=1.0.0-MVP
# Lista separada por vírgulas de origens permitidas no CORS
CORS_ORIGINS=http://localhost:5173

# ============================================================
# Frontend — Vite (variáveis expostas ao browser, prefixo VITE_)
# ============================================================
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIRESTORE_DB=(default)
